namespace WorkflowEngine.Application.Queries;

/// <summary>
/// Application-level input for starting a workflow.
/// </summary>
public sealed record StartWorkflowRequest
{
    /// <summary>
    /// Stable, unique code agreed between WorkflowEngine and its calling services.
    /// This is not a display name or a database identifier; WorkflowEngine resolves
    /// it to the internal WorkflowDefinitionId.
    /// </summary>
    public required string WorkflowDefinitionCode { get; init; }

    public required string BusinessType { get; init; }

    public required string BusinessReference { get; init; }

    public required string CorrelationId { get; init; }

    public required string IdempotencyKey { get; init; }

    public required int ContractSchemaVersion { get; init; }

    public required object Input { get; init; }
}
