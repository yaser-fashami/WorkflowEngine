@WorkfloeEngine.API_HostAddress = http://localhost:5296

# GET {{WorkfloeEngine.API_HostAddress}}/api/workflows/start
# Accept: application/json


@baseUrl = http://localhost:5296

### Ping
GET http://localhost:5296/api/workflows/ping
###

@token = eyJhbGciOi...
@workflowDefinitionId = 3fa85f64-5717-4562-b3fc-2c963f66afa6
@workflowInstanceId = 3fa85f64-5717-4562-b3fc-2c963f66afa6


### Start Workflow
POST {{baseUrl}}/api/workflows/start
Content-Type: application/json

{
  "workflowDefinitionId": "{{workflowDefinitionId}}",
  "input": {
    "customerId": "12345",
    "amount": 1000
  }
}


### Execute Workflow Action
POST {{baseUrl}}/api/workflows/{{workflowInstanceId}}/actions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "Approve"
}



